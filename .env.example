# Variables para la interpolación `${...}` del propio docker-compose.yml
# (usadas hoy en `build.args` de `web`/`admin`). Copiar a `.env` (no versionado)
# en el mismo directorio que docker-compose.yml — Docker Compose lo carga
# automáticamente para CUALQUIER invocación (`docker compose build`,
# `docker compose up`, etc.), sin necesitar `--env-file`.
#
# Esto es DISTINTO de `.env.web`/`.env.admin`/`.env.api`/`.env.mariadb`, que
# son el `env_file:` de cada contenedor en RUNTIME. Los valores NEXT_PUBLIC_*
# de acá deben coincidir con los de `.env.web`/`.env.admin`.

NEXT_PUBLIC_API_URL="https://api.funeraria-minaya.pe/api/v1"
NEXT_PUBLIC_SITE_URL="https://www.funeraria-minaya.pe"
NEXT_PUBLIC_WHATSAPP_NUMBER="51999999999"
