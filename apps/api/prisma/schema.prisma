// Esquema inicial de Fase 0 — Funeraria Minaya
// Fuente de verdad: /docs/10_modelo_datos.md y /docs/11_convencion_base_datos.md
// Solo tablas fundacionales; el resto se agrega por fase según /docs/33_roadmap.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 10.1 — Configuración global de la empresa (fila única, id=1)
model CompanyConfig {
  id                      BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  razonSocial             String   @map("razon_social") @db.VarChar(200)
  nombreComercial         String   @map("nombre_comercial") @db.VarChar(200)
  ruc                     String   @db.VarChar(11)
  direccionFiscal         String?  @map("direccion_fiscal") @db.VarChar(255)
  telefono                String?  @db.VarChar(30)
  correo                  String?  @db.VarChar(150)
  igvPorcentaje           Decimal  @default(18.00) @map("igv_porcentaje") @db.Decimal(5, 2)
  moneda                  String   @default("PEN") @db.VarChar(3)
  comprasDescentralizadas Boolean  @default(false) @map("compras_descentralizadas")
  logoUrl                 String?  @map("logo_url") @db.VarChar(500)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("configuracion_empresa")
}

/// 10.2 — Sedes (sucursales). is_main_flag es columna generada por SQL
/// (migración manual) para forzar una única sede principal (RB-024).
model Branch {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo       String    @unique @db.VarChar(20)
  nombre       String    @db.VarChar(150)
  descripcion  String?   @db.VarChar(500)
  direccion    String?   @db.VarChar(255)
  departamento String?   @db.VarChar(100)
  provincia    String?   @db.VarChar(100)
  distrito     String?   @db.VarChar(100)
  telefono     String?   @db.VarChar(30)
  correo       String?   @db.VarChar(150)
  isActive     Boolean   @default(true) @map("is_active")
  isMain       Boolean   @default(false) @map("is_main")
  /// Generada en SQL: 1 si is_main=1, NULL en caso contrario (ver migración).
  isMainFlag   Int?      @map("is_main_flag") @db.TinyInt
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  userBranches         UserBranch[]
  branchServices       BranchService[]
  inventories          Inventory[]
  movements            InventoryMovement[]
  purchases            Purchase[]
  transfersOut         InventoryTransfer[] @relation("TransferOrigin")
  transfersIn          InventoryTransfer[] @relation("TransferDestination")
  sales                Sale[]
  contractedServices   ContractedService[]
  payments             Payment[]
  destinosPago         DestinoPago[]
  quotationsAssigned   Quotation[]         @relation("QuotationAssignedBranch")
  quotationsPreferidas Quotation[]         @relation("QuotationPreferredBranch")

  @@unique([isMainFlag])
  @@map("sedes")
}

/// 10.3 — Roles de usuario
model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  codigo      String   @unique @db.VarChar(40)
  nombre      String   @db.VarChar(150)
  descripcion String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  userBranches    UserBranch[]

  @@map("roles")
}

/// 10.3 — Permisos granulares (código estilo "ventas.crear")
model Permission {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  codigo      String   @unique @db.VarChar(100)
  nombre      String   @db.VarChar(150)
  modulo      String   @db.VarChar(60)
  descripcion String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permisos")
}

/// 10.3 — rol_permiso (N:M)
model RolePermission {
  id        BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  rolId     BigInt @map("rol_id") @db.UnsignedBigInt
  permisoId BigInt @map("permiso_id") @db.UnsignedBigInt

  role       Role       @relation(fields: [rolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission Permission @relation(fields: [permisoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([rolId, permisoId])
  @@map("rol_permiso")
}

/// 10.3 — Usuarios del sistema
model User {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  nombres            String    @db.VarChar(150)
  apellidos          String    @db.VarChar(150)
  correo             String    @unique @db.VarChar(150)
  usuario            String    @unique @db.VarChar(60)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  telefono           String?   @db.VarChar(30)
  esCorporativo      Boolean   @default(false) @map("es_corporativo")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  ultimoLoginAt      DateTime? @map("ultimo_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  userRoles                UserRole[]
  userBranches             UserBranch[]
  refreshTokens            RefreshToken[]
  movements                InventoryMovement[]
  purchases                Purchase[]
  transfersRequested       InventoryTransfer[] @relation("TransferRequestedBy")
  transfersApproved        InventoryTransfer[] @relation("TransferApprovedBy")
  transfersSent            InventoryTransfer[] @relation("TransferSentBy")
  transfersReceived        InventoryTransfer[] @relation("TransferReceivedBy")
  sales                    Sale[]              @relation("SaleSeller")
  salesVoided              Sale[]              @relation("SaleVoidedBy")
  contractedServices       ContractedService[]
  payments                 Payment[]           @relation("PaymentRegisteredBy")
  paymentsVoided           Payment[]           @relation("PaymentVoidedBy")
  quotationsAssignedToUser Quotation[]         @relation("QuotationAssignedUser")

  @@map("usuarios")
}

/// 10.3 — refresh_tokens (rotación + revocación, RF-002/003)
model RefreshToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  usuarioId BigInt    @map("usuario_id") @db.UnsignedBigInt
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

/// 10.3 — usuario_rol (N:M)
model UserRole {
  id        BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  usuarioId BigInt @map("usuario_id") @db.UnsignedBigInt
  rolId     BigInt @map("rol_id") @db.UnsignedBigInt

  user User @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role Role @relation(fields: [rolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([usuarioId, rolId])
  @@map("usuario_rol")
}

/// 10.3 — usuario_sede: alcance de sede por usuario (base de SedeScopeGuard)
model UserBranch {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  usuarioId BigInt   @map("usuario_id") @db.UnsignedBigInt
  sedeId    BigInt   @map("sede_id") @db.UnsignedBigInt
  rolId     BigInt?  @map("rol_id") @db.UnsignedBigInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch @relation(fields: [sedeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role   Role?  @relation(fields: [rolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([usuarioId, sedeId])
  @@map("usuario_sede")
}

/// 10.4 — Categorías de producto
model ProductCategory {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nombre      String   @unique @db.VarChar(120)
  descripcion String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categorias_producto")
}

/// 10.4 — Catálogo maestro de productos (sin stock, ver ADR-008)
model Product {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo              String    @unique @db.VarChar(40)
  nombre              String    @db.VarChar(200)
  descripcion         String?   @db.Text
  categoriaProductoId BigInt    @map("categoria_producto_id") @db.UnsignedBigInt
  unidadMedida        String    @map("unidad_medida") @db.VarChar(20)
  precioVenta         Decimal   @map("precio_venta") @db.Decimal(12, 2)
  afectoIgv           Boolean   @default(true) @map("afecto_igv")
  imagenUrl           String?   @map("imagen_url") @db.VarChar(500)
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  categoria      ProductCategory         @relation(fields: [categoriaProductoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planItems      PlanItem[]
  inventories    Inventory[]
  movements      InventoryMovement[]
  purchaseItems  PurchaseItem[]
  transferItems  InventoryTransferItem[]
  saleItems      SaleItem[]
  quotationItems QuotationItem[]

  @@map("productos")
}

/// 10.4 — Servicios funerarios (precio corporativo + override por sede)
model Service {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo      String    @unique @db.VarChar(40)
  nombre      String    @db.VarChar(200)
  descripcion String?   @db.Text
  precioBase  Decimal   @map("precio_base") @db.Decimal(12, 2)
  afectoIgv   Boolean   @default(true) @map("afecto_igv")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  branchServices BranchService[]
  planItems      PlanItem[]
  saleItems      SaleItem[]
  quotationItems QuotationItem[]

  @@map("servicios")
}

/// 10.4 — Disponibilidad y precio override de un servicio por sede (RB-029)
model BranchService {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sedeId     BigInt   @map("sede_id") @db.UnsignedBigInt
  servicioId BigInt   @map("servicio_id") @db.UnsignedBigInt
  disponible Boolean  @default(true)
  precio     Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  branch  Branch  @relation(fields: [sedeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service Service @relation(fields: [servicioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sedeId, servicioId])
  @@map("sede_servicio")
}

/// 10.4 — Planes/paquetes
model Plan {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo      String    @unique @db.VarChar(40)
  nombre      String    @db.VarChar(200)
  descripcion String?   @db.Text
  precio      Decimal   @db.Decimal(12, 2)
  afectoIgv   Boolean   @default(true) @map("afecto_igv")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  items      PlanItem[]
  saleItems  SaleItem[]
  quotations Quotation[]

  @@map("planes")
}

/// 10.4 — Componentes de un plan (CHECK de coherencia en migración)
model PlanItem {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  planId     BigInt   @map("plan_id") @db.UnsignedBigInt
  itemTipo   String   @map("item_tipo") @db.VarChar(10)
  productoId BigInt?  @map("producto_id") @db.UnsignedBigInt
  servicioId BigInt?  @map("servicio_id") @db.UnsignedBigInt
  cantidad   Decimal  @db.Decimal(12, 3)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  producto Product? @relation(fields: [productoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  servicio Service? @relation(fields: [servicioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([planId])
  @@map("plan_items")
}

/// 10.5 — Clientes (corporativos, compartidos entre sedes — ADR-015)
model Customer {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tipoDocumento   String    @map("tipo_documento") @db.VarChar(10)
  numeroDocumento String    @map("numero_documento") @db.VarChar(20)
  nombres         String    @db.VarChar(150)
  apellidos       String?   @db.VarChar(150)
  telefono        String?   @db.VarChar(30)
  correo          String?   @db.VarChar(150)
  direccion       String?   @db.VarChar(255)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sales      Sale[]
  financings Financing[]
  quotations Quotation[]

  @@unique([tipoDocumento, numeroDocumento])
  @@map("clientes")
}

/// 10.5 — Métodos de pago (no confundir con financiadores, ADR-012)
model PaymentMethod {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  codigo     String   @unique @db.VarChar(20)
  nombre     String   @db.VarChar(100)
  esEfectivo Boolean  @map("es_efectivo")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  payments Payment[]

  @@map("metodos_pago")
}

/// 10.5 — Proveedores (RF-035)
model Supplier {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tipoDocumento   String    @map("tipo_documento") @db.VarChar(10)
  numeroDocumento String    @map("numero_documento") @db.VarChar(20)
  razonSocial     String    @map("razon_social") @db.VarChar(200)
  nombreComercial String?   @map("nombre_comercial") @db.VarChar(200)
  telefono        String?   @db.VarChar(30)
  correo          String?   @db.VarChar(150)
  direccion       String?   @db.VarChar(255)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  purchases Purchase[]

  @@unique([tipoDocumento, numeroDocumento])
  @@map("proveedores")
}

/// 10.6 — Inventario por sede (RB-002, ADR-008)
model Inventory {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sedeId        BigInt   @map("sede_id") @db.UnsignedBigInt
  productoId    BigInt   @map("producto_id") @db.UnsignedBigInt
  stockActual   Decimal  @default(0) @map("stock_actual") @db.Decimal(12, 3)
  stockMinimo   Decimal  @default(0) @map("stock_minimo") @db.Decimal(12, 3)
  stockMaximo   Decimal? @map("stock_maximo") @db.Decimal(12, 3)
  costoPromedio Decimal  @default(0) @map("costo_promedio") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  branch   Branch  @relation(fields: [sedeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  producto Product @relation(fields: [productoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sedeId, productoId])
  @@map("inventarios")
}

/// 10.6 — Kardex: fuente de verdad histórica del stock (RF-042/043)
model InventoryMovement {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sedeId         BigInt   @map("sede_id") @db.UnsignedBigInt
  productoId     BigInt   @map("producto_id") @db.UnsignedBigInt
  tipo           String   @db.VarChar(24)
  cantidad       Decimal  @db.Decimal(12, 3)
  costoUnitario  Decimal? @map("costo_unitario") @db.Decimal(12, 2)
  stockAnterior  Decimal  @map("stock_anterior") @db.Decimal(12, 3)
  stockPosterior Decimal  @map("stock_posterior") @db.Decimal(12, 3)
  documentoTipo  String?  @map("documento_tipo") @db.VarChar(24)
  documentoId    BigInt?  @map("documento_id") @db.UnsignedBigInt
  motivo         String?  @db.VarChar(255)
  usuarioId      BigInt   @map("usuario_id") @db.UnsignedBigInt
  createdAt      DateTime @default(now()) @map("created_at")

  branch   Branch  @relation(fields: [sedeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  producto Product @relation(fields: [productoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario  User    @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sedeId, productoId, createdAt])
  @@index([documentoTipo, documentoId])
  @@index([tipo])
  @@map("movimientos_inventario")
}

/// 10.7 — Compras centralizadas (RB-001, ADR-007)
model Purchase {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sedeId          BigInt    @map("sede_id") @db.UnsignedBigInt
  proveedorId     BigInt    @map("proveedor_id") @db.UnsignedBigInt
  numeroDocumento String?   @map("numero_documento") @db.VarChar(40)
  fecha           DateTime  @db.Date
  subtotal        Decimal   @default(0) @db.Decimal(12, 2)
  igv             Decimal   @default(0) @db.Decimal(12, 2)
  total           Decimal   @default(0) @db.Decimal(12, 2)
  estado          String    @default("BORRADOR") @db.VarChar(16)
  usuarioId       BigInt    @map("usuario_id") @db.UnsignedBigInt
  observaciones   String?   @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  branch    Branch         @relation(fields: [sedeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  proveedor Supplier       @relation(fields: [proveedorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario   User           @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items     PurchaseItem[]

  @@map("compras")
}

/// 10.7 — detalle_compra
model PurchaseItem {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  compraId      BigInt   @map("compra_id") @db.UnsignedBigInt
  productoId    BigInt   @map("producto_id") @db.UnsignedBigInt
  cantidad      Decimal  @db.Decimal(12, 3)
  costoUnitario Decimal  @map("costo_unitario") @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  afectoIgv     Boolean  @default(true) @map("afecto_igv")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  purchase Purchase @relation(fields: [compraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  producto Product  @relation(fields: [productoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([compraId])
  @@map("detalle_compra")
}

/// 10.8 — Transferencias entre sedes (ADR-013)
model InventoryTransfer {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo            String    @unique @db.VarChar(30)
  sedeOrigenId      BigInt    @map("sede_origen_id") @db.UnsignedBigInt
  sedeDestinoId     BigInt    @map("sede_destino_id") @db.UnsignedBigInt
  estado            String    @default("SOLICITADA") @db.VarChar(16)
  motivo            String?   @db.VarChar(255)
  usuarioSolicitaId BigInt    @map("usuario_solicita_id") @db.UnsignedBigInt
  usuarioApruebaId  BigInt?   @map("usuario_aprueba_id") @db.UnsignedBigInt
  usuarioEnviaId    BigInt?   @map("usuario_envia_id") @db.UnsignedBigInt
  usuarioRecibeId   BigInt?   @map("usuario_recibe_id") @db.UnsignedBigInt
  fechaSolicitud    DateTime? @map("fecha_solicitud")
  fechaEnvio        DateTime? @map("fecha_envio")
  fechaRecepcion    DateTime? @map("fecha_recepcion")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  sedeOrigen      Branch                  @relation("TransferOrigin", fields: [sedeOrigenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sedeDestino     Branch                  @relation("TransferDestination", fields: [sedeDestinoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioSolicita User                    @relation("TransferRequestedBy", fields: [usuarioSolicitaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioAprueba  User?                   @relation("TransferApprovedBy", fields: [usuarioApruebaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioEnvia    User?                   @relation("TransferSentBy", fields: [usuarioEnviaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioRecibe   User?                   @relation("TransferReceivedBy", fields: [usuarioRecibeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items           InventoryTransferItem[]

  @@map("transferencias_inventario")
}

/// 10.8 — detalle_transferencia_inventario. costoUnitario: snapshot del costo
/// promedio de origen al enviar, para aplicarlo en destino al recibir
/// (docs/19 §19.2: "se guarda en el detalle o en el movimiento").
model InventoryTransferItem {
  id                        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  transferenciaInventarioId BigInt   @map("transferencia_inventario_id") @db.UnsignedBigInt
  productoId                BigInt   @map("producto_id") @db.UnsignedBigInt
  cantidad                  Decimal  @db.Decimal(12, 3)
  costoUnitario             Decimal? @map("costo_unitario") @db.Decimal(12, 2)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  transfer InventoryTransfer @relation(fields: [transferenciaInventarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  producto Product           @relation(fields: [productoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([transferenciaInventarioId])
  @@map("detalle_transferencia_inventario")
}

/// 10.13 — Cotizaciones internas (RF-080..086). El origen WEB público llega en Fase 6.
model Quotation {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo              String    @unique @db.VarChar(30)
  origen              String    @db.VarChar(12)
  solicitanteNombres  String    @map("solicitante_nombres") @db.VarChar(150)
  solicitanteTelefono String    @map("solicitante_telefono") @db.VarChar(30)
  solicitanteCorreo   String?   @map("solicitante_correo") @db.VarChar(150)
  clienteId           BigInt?   @map("cliente_id") @db.UnsignedBigInt
  sedePreferidaId     BigInt?   @map("sede_preferida_id") @db.UnsignedBigInt
  sedeAsignadaId      BigInt?   @map("sede_asignada_id") @db.UnsignedBigInt
  planId              BigInt?   @map("plan_id") @db.UnsignedBigInt
  observaciones       String?   @db.VarChar(1000)
  estado              String    @default("SOLICITADA") @db.VarChar(16)
  fecha               DateTime  @default(now())
  validoHasta         DateTime? @map("valido_hasta") @db.Date
  consentimientoDatos Boolean   @default(false) @map("consentimiento_datos")
  usuarioAsignadoId   BigInt?   @map("usuario_asignado_id") @db.UnsignedBigInt
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  cliente         Customer?       @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sedePreferida   Branch?         @relation("QuotationPreferredBranch", fields: [sedePreferidaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sedeAsignada    Branch?         @relation("QuotationAssignedBranch", fields: [sedeAsignadaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  plan            Plan?           @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioAsignado User?           @relation("QuotationAssignedUser", fields: [usuarioAsignadoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items           QuotationItem[]
  sales           Sale[]

  @@map("cotizaciones")
}

/// 10.13 — detalle_cotizacion
model QuotationItem {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  cotizacionId      BigInt   @map("cotizacion_id") @db.UnsignedBigInt
  itemTipo          String   @map("item_tipo") @db.VarChar(10)
  productoId        BigInt?  @map("producto_id") @db.UnsignedBigInt
  servicioId        BigInt?  @map("servicio_id") @db.UnsignedBigInt
  cantidad          Decimal  @db.Decimal(12, 3)
  precioReferencial Decimal? @map("precio_referencial") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  quotation Quotation @relation(fields: [cotizacionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  producto  Product?  @relation(fields: [productoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  servicio  Service?  @relation(fields: [servicioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([cotizacionId])
  @@map("detalle_cotizacion")
}

/// 10.9 — Ventas (RB-006). sede_venta_id ≠ pagos.sede_cobro_id (ADR-009).
model Sale {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo        String    @unique @db.VarChar(30)
  sedeVentaId   BigInt    @map("sede_venta_id") @db.UnsignedBigInt
  clienteId     BigInt    @map("cliente_id") @db.UnsignedBigInt
  usuarioId     BigInt    @map("usuario_id") @db.UnsignedBigInt
  cotizacionId  BigInt?   @map("cotizacion_id") @db.UnsignedBigInt
  fecha         DateTime  @default(now())
  subtotal      Decimal   @db.Decimal(12, 2)
  descuento     Decimal   @default(0) @db.Decimal(12, 2)
  baseImponible Decimal   @map("base_imponible") @db.Decimal(12, 2)
  igv           Decimal   @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(12, 2)
  estado        String    @default("CONFIRMADA") @db.VarChar(16)
  observaciones String?   @db.VarChar(500)
  anuladaMotivo String?   @map("anulada_motivo") @db.VarChar(255)
  anuladaPor    BigInt?   @map("anulada_por") @db.UnsignedBigInt
  anuladaAt     DateTime? @map("anulada_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  sedeVenta          Branch              @relation(fields: [sedeVentaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cliente            Customer            @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vendedor           User                @relation("SaleSeller", fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  anuladaPorUsuario  User?               @relation("SaleVoidedBy", fields: [anuladaPor], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cotizacion         Quotation?          @relation(fields: [cotizacionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items              SaleItem[]
  contractedServices ContractedService[]
  financings         Financing[]
  payments           Payment[]

  @@map("ventas")
}

/// 10.9 — detalle_venta. Precio y descripción se snapshotean (docs/20 §20.2).
model SaleItem {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  ventaId        BigInt   @map("venta_id") @db.UnsignedBigInt
  itemTipo       String   @map("item_tipo") @db.VarChar(10)
  productoId     BigInt?  @map("producto_id") @db.UnsignedBigInt
  servicioId     BigInt?  @map("servicio_id") @db.UnsignedBigInt
  planId         BigInt?  @map("plan_id") @db.UnsignedBigInt
  descripcion    String   @db.VarChar(200)
  cantidad       Decimal  @db.Decimal(12, 3)
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  descuentoLinea Decimal  @default(0) @map("descuento_linea") @db.Decimal(12, 2)
  afectoIgv      Boolean  @map("afecto_igv")
  subtotal       Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  venta    Sale     @relation(fields: [ventaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  producto Product? @relation(fields: [productoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  servicio Service? @relation(fields: [servicioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  plan     Plan?    @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ventaId])
  @@map("detalle_venta")
}

/// 10.9 — Operación funeraria vinculada a la venta (ADR-014, docs/20 §20.6)
model ContractedService {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ventaId              BigInt    @map("venta_id") @db.UnsignedBigInt
  sedeId               BigInt    @map("sede_id") @db.UnsignedBigInt
  tipoServicio         String    @map("tipo_servicio") @db.VarChar(40)
  fechaServicio        DateTime? @map("fecha_servicio")
  lugar                String?   @db.VarChar(200)
  estadoOperativo      String    @default("PROGRAMADO") @map("estado_operativo") @db.VarChar(20)
  responsableUsuarioId BigInt?   @map("responsable_usuario_id") @db.UnsignedBigInt
  observaciones        String?   @db.VarChar(500)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  venta              Sale   @relation(fields: [ventaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch             Branch @relation(fields: [sedeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsableUsuario User?  @relation(fields: [responsableUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("servicios_contratados")
}

/// 10.10 — Financiamiento (ADR-010). financiadorId sin FK todavía: el catálogo
/// `financiadores` se construye en Fase 4; hasta entonces origenTipo siempre
/// es 'CLIENTE' y financiadorId queda NULL.
model Financing {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ventaId               BigInt    @map("venta_id") @db.UnsignedBigInt
  origenTipo            String    @map("origen_tipo") @db.VarChar(12)
  clienteId             BigInt?   @map("cliente_id") @db.UnsignedBigInt
  financiadorId         BigInt?   @map("financiador_id") @db.UnsignedBigInt
  monto                 Decimal   @db.Decimal(12, 2)
  montoAutorizado       Decimal?  @map("monto_autorizado") @db.Decimal(12, 2)
  estado                String    @default("PENDIENTE") @db.VarChar(24)
  numeroPoliza          String?   @map("numero_poliza") @db.VarChar(60)
  documentoCoberturaUrl String?   @map("documento_cobertura_url") @db.VarChar(500)
  fechaSolicitud        DateTime? @map("fecha_solicitud")
  fechaAprobacion       DateTime? @map("fecha_aprobacion")
  fechaPago             DateTime? @map("fecha_pago")
  observaciones         String?   @db.VarChar(500)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  venta    Sale      @relation(fields: [ventaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cliente  Customer? @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments Payment[]

  @@map("financiamientos")
}

/// 10.5 — Destinos de pago (RB-009/027). cajaId sin FK todavía: `cajas` llega
/// en Fase 5; hasta entonces los destinos tipo CAJA se administran sin
/// vincular una caja específica.
model DestinoPago {
  id                   BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tipo                 String   @db.VarChar(20)
  nombre               String   @db.VarChar(150)
  sedeAdministradoraId BigInt?  @map("sede_administradora_id") @db.UnsignedBigInt
  cajaId               BigInt?  @map("caja_id") @db.UnsignedBigInt
  numeroReferencia     String?  @map("numero_referencia") @db.VarChar(80)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  sedeAdministradora Branch?   @relation(fields: [sedeAdministradoraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments           Payment[]

  @@map("destinos_pago")
}

/// 10.11 — Pagos (ADR-010/011). aperturaCajaId sin FK todavía (Fase 5).
model Payment {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  financiamientoId BigInt    @map("financiamiento_id") @db.UnsignedBigInt
  ventaId          BigInt    @map("venta_id") @db.UnsignedBigInt
  monto            Decimal   @db.Decimal(12, 2)
  metodoPagoId     BigInt    @map("metodo_pago_id") @db.UnsignedBigInt
  destinoPagoId    BigInt    @map("destino_pago_id") @db.UnsignedBigInt
  sedeCobroId      BigInt    @map("sede_cobro_id") @db.UnsignedBigInt
  aperturaCajaId   BigInt?   @map("apertura_caja_id") @db.UnsignedBigInt
  fecha            DateTime  @default(now())
  estado           String    @default("CONFIRMADO") @db.VarChar(16)
  referencia       String?   @db.VarChar(100)
  usuarioId        BigInt    @map("usuario_id") @db.UnsignedBigInt
  anuladoMotivo    String?   @map("anulado_motivo") @db.VarChar(255)
  anuladoPor       BigInt?   @map("anulado_por") @db.UnsignedBigInt
  anuladoAt        DateTime? @map("anulado_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  financing         Financing     @relation(fields: [financiamientoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  venta             Sale          @relation(fields: [ventaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  metodoPago        PaymentMethod @relation(fields: [metodoPagoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  destinoPago       DestinoPago   @relation(fields: [destinoPagoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sedeCobro         Branch        @relation(fields: [sedeCobroId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario           User          @relation("PaymentRegisteredBy", fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  anuladoPorUsuario User?         @relation("PaymentVoidedBy", fields: [anuladoPor], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("pagos")
}
