// Esquema inicial de Fase 0 — Funeraria Minaya
// Fuente de verdad: /docs/10_modelo_datos.md y /docs/11_convencion_base_datos.md
// Solo tablas fundacionales; el resto se agrega por fase según /docs/33_roadmap.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 10.1 — Configuración global de la empresa (fila única, id=1)
model CompanyConfig {
  id                      BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  razonSocial             String   @map("razon_social") @db.VarChar(200)
  nombreComercial         String   @map("nombre_comercial") @db.VarChar(200)
  ruc                     String   @db.VarChar(11)
  direccionFiscal         String?  @map("direccion_fiscal") @db.VarChar(255)
  telefono                String?  @db.VarChar(30)
  correo                  String?  @db.VarChar(150)
  igvPorcentaje           Decimal  @default(18.00) @map("igv_porcentaje") @db.Decimal(5, 2)
  moneda                  String   @default("PEN") @db.VarChar(3)
  comprasDescentralizadas Boolean  @default(false) @map("compras_descentralizadas")
  logoUrl                 String?  @map("logo_url") @db.VarChar(500)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("configuracion_empresa")
}

/// 10.2 — Sedes (sucursales). is_main_flag es columna generada por SQL
/// (migración manual) para forzar una única sede principal (RB-024).
model Branch {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo       String    @unique @db.VarChar(20)
  nombre       String    @db.VarChar(150)
  descripcion  String?   @db.VarChar(500)
  direccion    String?   @db.VarChar(255)
  departamento String?   @db.VarChar(100)
  provincia    String?   @db.VarChar(100)
  distrito     String?   @db.VarChar(100)
  telefono     String?   @db.VarChar(30)
  correo       String?   @db.VarChar(150)
  isActive     Boolean   @default(true) @map("is_active")
  isMain       Boolean   @default(false) @map("is_main")
  /// Generada en SQL: 1 si is_main=1, NULL en caso contrario (ver migración).
  isMainFlag   Int?      @map("is_main_flag") @db.TinyInt
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  userBranches   UserBranch[]
  branchServices BranchService[]

  @@unique([isMainFlag])
  @@map("sedes")
}

/// 10.3 — Roles de usuario
model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  codigo      String   @unique @db.VarChar(40)
  nombre      String   @db.VarChar(150)
  descripcion String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  userBranches    UserBranch[]

  @@map("roles")
}

/// 10.3 — Permisos granulares (código estilo "ventas.crear")
model Permission {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  codigo      String   @unique @db.VarChar(100)
  nombre      String   @db.VarChar(150)
  modulo      String   @db.VarChar(60)
  descripcion String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permisos")
}

/// 10.3 — rol_permiso (N:M)
model RolePermission {
  id        BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  rolId     BigInt @map("rol_id") @db.UnsignedBigInt
  permisoId BigInt @map("permiso_id") @db.UnsignedBigInt

  role       Role       @relation(fields: [rolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission Permission @relation(fields: [permisoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([rolId, permisoId])
  @@map("rol_permiso")
}

/// 10.3 — Usuarios del sistema
model User {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  nombres            String    @db.VarChar(150)
  apellidos          String    @db.VarChar(150)
  correo             String    @unique @db.VarChar(150)
  usuario            String    @unique @db.VarChar(60)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  telefono           String?   @db.VarChar(30)
  esCorporativo      Boolean   @default(false) @map("es_corporativo")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  ultimoLoginAt      DateTime? @map("ultimo_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  userRoles     UserRole[]
  userBranches  UserBranch[]
  refreshTokens RefreshToken[]

  @@map("usuarios")
}

/// 10.3 — refresh_tokens (rotación + revocación, RF-002/003)
model RefreshToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  usuarioId BigInt    @map("usuario_id") @db.UnsignedBigInt
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

/// 10.3 — usuario_rol (N:M)
model UserRole {
  id        BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  usuarioId BigInt @map("usuario_id") @db.UnsignedBigInt
  rolId     BigInt @map("rol_id") @db.UnsignedBigInt

  user User @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role Role @relation(fields: [rolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([usuarioId, rolId])
  @@map("usuario_rol")
}

/// 10.3 — usuario_sede: alcance de sede por usuario (base de SedeScopeGuard)
model UserBranch {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  usuarioId BigInt   @map("usuario_id") @db.UnsignedBigInt
  sedeId    BigInt   @map("sede_id") @db.UnsignedBigInt
  rolId     BigInt?  @map("rol_id") @db.UnsignedBigInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch @relation(fields: [sedeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role   Role?  @relation(fields: [rolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([usuarioId, sedeId])
  @@map("usuario_sede")
}

/// 10.4 — Categorías de producto
model ProductCategory {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nombre      String   @unique @db.VarChar(120)
  descripcion String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categorias_producto")
}

/// 10.4 — Catálogo maestro de productos (sin stock, ver ADR-008)
model Product {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo              String    @unique @db.VarChar(40)
  nombre              String    @db.VarChar(200)
  descripcion         String?   @db.Text
  categoriaProductoId BigInt    @map("categoria_producto_id") @db.UnsignedBigInt
  unidadMedida        String    @map("unidad_medida") @db.VarChar(20)
  precioVenta         Decimal   @map("precio_venta") @db.Decimal(12, 2)
  afectoIgv           Boolean   @default(true) @map("afecto_igv")
  imagenUrl           String?   @map("imagen_url") @db.VarChar(500)
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  categoria ProductCategory @relation(fields: [categoriaProductoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planItems PlanItem[]

  @@map("productos")
}

/// 10.4 — Servicios funerarios (precio corporativo + override por sede)
model Service {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo      String    @unique @db.VarChar(40)
  nombre      String    @db.VarChar(200)
  descripcion String?   @db.Text
  precioBase  Decimal   @map("precio_base") @db.Decimal(12, 2)
  afectoIgv   Boolean   @default(true) @map("afecto_igv")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  branchServices BranchService[]
  planItems      PlanItem[]

  @@map("servicios")
}

/// 10.4 — Disponibilidad y precio override de un servicio por sede (RB-029)
model BranchService {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sedeId     BigInt   @map("sede_id") @db.UnsignedBigInt
  servicioId BigInt   @map("servicio_id") @db.UnsignedBigInt
  disponible Boolean  @default(true)
  precio     Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  branch  Branch  @relation(fields: [sedeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service Service @relation(fields: [servicioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sedeId, servicioId])
  @@map("sede_servicio")
}

/// 10.4 — Planes/paquetes
model Plan {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo      String    @unique @db.VarChar(40)
  nombre      String    @db.VarChar(200)
  descripcion String?   @db.Text
  precio      Decimal   @db.Decimal(12, 2)
  afectoIgv   Boolean   @default(true) @map("afecto_igv")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  items PlanItem[]

  @@map("planes")
}

/// 10.4 — Componentes de un plan (CHECK de coherencia en migración)
model PlanItem {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  planId     BigInt   @map("plan_id") @db.UnsignedBigInt
  itemTipo   String   @map("item_tipo") @db.VarChar(10)
  productoId BigInt?  @map("producto_id") @db.UnsignedBigInt
  servicioId BigInt?  @map("servicio_id") @db.UnsignedBigInt
  cantidad   Decimal  @db.Decimal(12, 3)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  producto Product? @relation(fields: [productoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  servicio Service? @relation(fields: [servicioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([planId])
  @@map("plan_items")
}

/// 10.5 — Clientes (corporativos, compartidos entre sedes — ADR-015)
model Customer {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tipoDocumento   String    @map("tipo_documento") @db.VarChar(10)
  numeroDocumento String    @map("numero_documento") @db.VarChar(20)
  nombres         String    @db.VarChar(150)
  apellidos       String?   @db.VarChar(150)
  telefono        String?   @db.VarChar(30)
  correo          String?   @db.VarChar(150)
  direccion       String?   @db.VarChar(255)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@unique([tipoDocumento, numeroDocumento])
  @@map("clientes")
}

/// 10.5 — Métodos de pago (no confundir con financiadores, ADR-012)
model PaymentMethod {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  codigo     String   @unique @db.VarChar(20)
  nombre     String   @db.VarChar(100)
  esEfectivo Boolean  @map("es_efectivo")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("metodos_pago")
}
