# Copiar a .env (no versionado) y ajustar valores locales.

# MariaDB 11.8 nativa (Windows). Esquema mysql:// obligatorio (ver ADR-002).
DATABASE_URL="mysql://funeraria_app:cambia-esta-clave@localhost:3306/funeraria_minaya"

PORT=3001
NODE_ENV=development

# Orígenes permitidos por CORS (separados por coma). Puertos de dev: web=3000, admin=3002.
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# Seed inicial (Fase 0) — opcional, tiene valores por defecto para dev.
SEED_EMPRESA_RAZON_SOCIAL="Funeraria Minaya S.A.C."
SEED_EMPRESA_RUC=20000000001
SEED_ADMIN_EMAIL=admin@funerariaminaya.pe
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=
