# Env del contenedor `api` en docker-compose (servidor). Copiar a .env.api (no versionado).
# Sin comillas en los valores: `docker compose up` (env_file:) las quita, pero
# `docker run --env-file` (usado para el seed puntual, ver DEPLOYMENT.md §7)
# no — quedarían como parte literal del valor y romperían `new URL(...)`.

DATABASE_URL=mysql://funeraria_app:cambia-esta-clave@mariadb:3306/funeraria_minaya
PORT=3001
NODE_ENV=production
CORS_ORIGINS=https://app.funeraria-minaya.pe,https://www.funeraria-minaya.pe

# JWT (docs/16_seguridad.md §16.1) — obligatorios, sin valor por defecto en el
# código (JwtModule los toma de config sin fallback). Generar un valor propio
# por entorno, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh
JWT_REFRESH_EXPIRES_DAYS=7
